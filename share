import React, {
  useEffect,
  useMemo,
  useState,
  useCallback,
  useRef,
} from "react";
import { useQuery, useMutation, useQueryClient } from "@tanstack/react-query";

// =========================
// API
// =========================
import { auth } from "@/localApi/auth";
import { Catalog } from "@/localApi/catalog";
import { Registration } from "@/localApi/registration";
import { Reviews } from "@/localApi/reviews";

// =========================
// UI (shadcn)
// =========================
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Card } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import { Checkbox } from "@/components/ui/checkbox";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";

import {
  Search,
  Plus,
  Check,
  MapPin,
  Users,
  BookOpen,
  Filter,
  X,
  Star,
  TrendingUp,
  Info,
} from "lucide-react";

// =========================
// Dialogs
// =========================
import RatingDialog from "../components/courses/RatingDialog.jsx";
import CourseRatings from "../components/courses/CourseRatings.jsx";
import CourseDetailDialog from "../components/courses/CourseDetailDialog.jsx";
import AIChatbot from "../components/chatbot/AIChatbot.jsx";

// ======================================================
// CONSTANTS
// ======================================================
const LANGUAGE_OPTIONS = [
  { label: "English (International)", value: "국제어수업" },
  { label: "Korean (General)", value: "일반수업" },
  { label: "Online + English", value: "중대형온라인강의 + 국제어" },
  { label: "Online", value: "중대형온라인강의" },
];

const DAYS = [
  "Monday",
  "Tuesday",
  "Wednesday",
  "Thursday",
  "Friday",
  "Saturday",
  "Sunday",
];

const DAY_NAME_TO_INDEX = {
  Monday: 1,
  Tuesday: 2,
  Wednesday: 3,
  Thursday: 4,
  Friday: 5,
  Saturday: 6,
  Sunday: 7,
};

const CAMPUS_LOOKUP = {
  1: "HSSC",
  2: "NSC",
  3: "iCampus",
};

// ======================================================
// COMPONENT
// ======================================================
export default function Courses() {
  const queryClient = useQueryClient();
  const baseUrl = import.meta.env.VITE_API_BASE_URL || "http://localhost:8080";

  // =========================
  // STATE
  // =========================
  const [user, setUser] = useState(null);
  const [searchTerm, setSearchTerm] = useState("");
  const [courses, setCourses] = useState([]);
  const [isLoading, setIsLoading] = useState(false);

  const [categories, setCategories] = useState([]);
  const [colleges, setColleges] = useState([]);
  const [majors, setMajors] = useState([]);

  const [showSearchFilters, setShowSearchFilters] = useState(false);
  const [showResultFilters, setShowResultFilters] = useState(false);

  const [selectedCourse, setSelectedCourse] = useState(null);
  const [ratingOpen, setRatingOpen] = useState(false);
  const [detailOpen, setDetailOpen] = useState(false);

  // =========================
  // FILTERS
  // =========================
  const [searchFilters, setSearchFilters] = useState({
    category: "all",
    college: "all",
    major: "all",
    language: "all",
    campus: "all",
    credits: "",
    timeOfDay: "all",
    days: [],
    minRating: "all",
  });

  const [resultFilters, setResultFilters] = useState({
    college: "all",
    major: "all",
    language: "all",
    campus: "all",
    credits: "all",
    timeOfDay: "all",
    days: [],
    minRating: "all",
  });

  // =========================
  // PERFORMANCE HELPERS
  // =========================
  const abortRef = useRef(null);
  const debounceRef = useRef(null);
  const searchCache = useRef(new Map());

  // =========================
  // AUTH
  // =========================
  useEffect(() => {
    setUser(auth.me());
  }, []);

  // =========================
  // FETCH STATIC DATA
  // =========================
  useEffect(() => {
    fetch(`${baseUrl}/courses/categories`)
      .then((r) => r.json())
      .then(setCategories)
      .catch(console.error);

    fetch(`${baseUrl}/courses/colleges`)
      .then((r) => r.json())
      .then(setColleges)
      .catch(console.error);
  }, [baseUrl]);

  useEffect(() => {
    if (searchFilters.college === "all") {
      setMajors([]);
      return;
    }

    fetch(`${baseUrl}/courses/colleges/${searchFilters.college}/majors`)
      .then((r) => r.json())
      .then(setMajors)
      .catch(console.error);
  }, [baseUrl, searchFilters.college]);

  // =========================
  // REACT QUERY
  // =========================
  const { data: catalog = [] } = useQuery({
    queryKey: ["catalog"],
    queryFn: Catalog.list,
  });

  const { data: reviews = [] } = useQuery({
    queryKey: ["reviews"],
    queryFn: Reviews.list,
  });

  const { data: registrations = [] } = useQuery({
    queryKey: ["registrations"],
    queryFn: Registration.list,
  });

  // =========================
  // NORMALIZE COURSE
  // =========================
  const normalizeCourse = useCallback((course) => {
    const schedule =
      course.timeRoomPlacements?.map((s) => ({
        day: DAYS[(s.day_of_week ?? 1) - 1],
        start: s.start_time?.slice(0, 5),
        end: s.end_time?.slice(0, 5),
      })) || [];

    return {
      id: course.id,
      code: course.courseCode,
      base: course.shortCourseCode,
      name: course.name_english || course.name_korean,
      description: course.description_english || "",
      credits: Number(course.credits),
      campus: CAMPUS_LOOKUP[course.campus] || "Unknown",
      instructor:
        course.instructor?.instructor_name || "TBA",
      schedule,
      language: course.course_language,
      enrolled: course.enrolled || 0,
      capacity: course.capacity || 0,
      majors: course.majors || [],
    };
  }, []);

  // =========================
  // SEARCH (DEBOUNCED + CACHED)
  // =========================
  const performSearch = useCallback(async () => {
    const cacheKey = JSON.stringify({ searchTerm, searchFilters });
    if (searchCache.current.has(cacheKey)) {
      setCourses(searchCache.current.get(cacheKey));
      return;
    }

    if (abortRef.current) abortRef.current.abort();
    abortRef.current = new AbortController();

    setIsLoading(true);

    try {
      const res = await fetch(`${baseUrl}/courses/search`, {
        method: "POST",
        signal: abortRef.current.signal,
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          searchTerm,
          category: searchFilters.category !== "all" ? searchFilters.category : null,
          collegeId: searchFilters.college !== "all" ? Number(searchFilters.college) : null,
          majorId: searchFilters.major !== "all" ? Number(searchFilters.major) : null,
          courseLanguage:
            searchFilters.language !== "all"
              ? LANGUAGE_OPTIONS.find((l) => l.label === searchFilters.language)?.value
              : null,
          credits: searchFilters.credits ? Number(searchFilters.credits) : 0,
          daysOfWeek: searchFilters.days.map((d) => DAY_NAME_TO_INDEX[d]),
          campus:
            searchFilters.campus === "HSSC" ? 1 :
            searchFilters.campus === "NSC" ? 2 :
            searchFilters.campus === "iCampus" ? 3 : 0,
          timeOfDay:
            searchFilters.timeOfDay !== "all"
              ? searchFilters.timeOfDay.toUpperCase()
              : "ALL",
        }),
      });

      const json = await res.json();
      const flat = Object.values(json || {}).flat().map(normalizeCourse);

      searchCache.current.set(cacheKey, flat);
      setCourses(flat);
    } catch (e) {
      if (e.name !== "AbortError") console.error(e);
    } finally {
      setIsLoading(false);
    }
  }, [searchTerm, searchFilters, baseUrl, normalizeCourse]);

  // =========================
  // DEBOUNCE EFFECT
  // =========================
  useEffect(() => {
    clearTimeout(debounceRef.current);
    debounceRef.current = setTimeout(performSearch, 500);
    return () => clearTimeout(debounceRef.current);
  }, [performSearch]);

  // =========================
  // MUTATIONS
  // =========================
  const addToCatalog = useMutation({
    mutationFn: Catalog.add,
    onSuccess: () => queryClient.invalidateQueries(["catalog"]),
  });

  const removeFromCatalog = useMutation({
    mutationFn: Catalog.remove,
    onSuccess: () => queryClient.invalidateQueries(["catalog"]),
  });

  // =========================
  // GROUP COURSES
  // =========================
  const groupedCourses = useMemo(() => {
    const map = {};
    courses.forEach((c) => {
      if (!map[c.base]) map[c.base] = [];
      map[c.base].push(c);
    });
    return map;
  }, [courses]);

  // ======================================================
  // UI
  // ======================================================
  return (
    <div className="min-h-screen bg-gray-50">
      <div className="max-w-7xl mx-auto p-6 space-y-6">

        {/* HEADER */}
        <div>
          <h1 className="text-4xl font-bold">Course Catalog</h1>
          <p className="text-gray-600">
            Search, review, and plan your semester efficiently
          </p>
        </div>

        {/* SEARCH */}
        <Card className="p-4 flex gap-3">
          <div className="relative flex-1">
            <Search className="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400" />
            <Input
              className="pl-10"
              placeholder="Search by course name, code, or instructor..."
              value={searchTerm}
              onChange={(e) => setSearchTerm(e.target.value)}
            />
          </div>
          <Button onClick={performSearch}>
            Search
          </Button>
          <Button variant="outline" onClick={() => setShowSearchFilters(!showSearchFilters)}>
            <Filter className="w-4 h-4 mr-1" />
            Filters
          </Button>
        </Card>

        {/* LOADING */}
        {isLoading && (
          <Card className="p-6 animate-pulse">
            <div className="h-4 bg-gray-200 rounded w-1/3 mb-2" />
            <div className="h-3 bg-gray-200 rounded w-2/3" />
          </Card>
        )}

        {/* COURSES */}
        {!isLoading && Object.keys(groupedCourses).length === 0 && (
          <Card className="p-6 text-center text-gray-600">
            No courses found. Try adjusting your filters.
          </Card>
        )}

        <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
          {Object.entries(groupedCourses).map(([code, sections]) => (
            <Card key={code} className="p-5 space-y-4">
              <div>
                <h3 className="text-xl font-bold">{code}</h3>
                <p className="text-gray-600">{sections[0].name}</p>
              </div>

              {sections.map((s) => {
                const inCatalog = catalog.some((c) => c.course_id === s.id);

                return (
                  <div
                    key={s.id}
                    className="flex justify-between items-center p-3 bg-gray-50 rounded-lg"
                  >
                    <div>
                      <p className="font-medium">{s.code}</p>
                      <p className="text-xs text-gray-500">
                        {s.instructor} • {s.campus}
                      </p>
                    </div>

                    <Button
                      size="sm"
                      onClick={() =>
                        inCatalog
                          ? removeFromCatalog.mutate(s.id)
                          : addToCatalog.mutate({
                              course_id: s.id,
                              course_code: s.code,
                              course_name: s.name,
                              base_code: s.base,
                            })
                      }
                    >
                      {inCatalog ? <Check /> : <Plus />}
                    </Button>
                  </div>
                );
              })}
            </Card>
          ))}
        </div>

        <AIChatbot allCourses={courses} />

        <RatingDialog
          open={ratingOpen}
          course={selectedCourse}
          onOpenChange={setRatingOpen}
        />

        <CourseDetailDialog
          open={detailOpen}
          course={selectedCourse}
          onOpenChange={setDetailOpen}
          allCourses={courses}
        />
      </div>
    </div>
  );
}

import React, { useEffect, useMemo, useState, useCallback } from "react";
import { useQuery, useMutation, useQueryClient } from "@tanstack/react-query";

// Local API
import { auth } from "@/localApi/auth";
import { Catalog } from "@/localApi/catalog";
import { Registration } from "@/localApi/registration";
import { Reviews } from "@/localApi/reviews";

// UI Components (shadcn)
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Card } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import { Checkbox } from "@/components/ui/checkbox";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";

import {
  Search,
  Plus,
  Check,
  MapPin,
  Users,
  BookOpen,
  Filter,
  X,
  Star,
  TrendingUp,
  Info,
} from "lucide-react";

// Dialogs
import RatingDialog from "../components/courses/RatingDialog.jsx";
import CourseRatings from "../components/courses/CourseRatings.jsx";
import CourseDetailDialog from "../components/courses/CourseDetailDialog.jsx";

// Chatbot
import AIChatbot from "../components/chatbot/AIChatbot.jsx";

export default function Courses() {
  const queryClient = useQueryClient();
  const baseUrl = import.meta.env.VITE_API_BASE_URL || "http://localhost:8080";

  const [user, setUser] = useState(null);

  const [searchTerm, setSearchTerm] = useState("");
  const [allCourses, setAllCourses] = useState([]);
  const [isSearching, setIsSearching] = useState(false);

  const [categories, setCategories] = useState([]);
  const [colleges, setColleges] = useState([]);
  const [majors, setMajors] = useState([]);

  const [showSearchFilters, setShowSearchFilters] = useState(false);
  const [showResultFilters, setShowResultFilters] = useState(false);

  const [ratingDialogOpen, setRatingDialogOpen] = useState(false);
  const [detailDialogOpen, setDetailDialogOpen] = useState(false);
  const [selectedCourse, setSelectedCourse] = useState(null);

  const LANGUAGE_OPTIONS = useMemo(
    () => [
      { label: "International (in English)", value: "국제어수업" },
      { label: "General (in Korean)", value: "일반수업" },
      { label: "Large Online + International", value: "중대형온라인강의 + 국제어" },
      { label: "Large Online", value: "중대형온라인강의" },
    ],
    []
  );

  const [searchFilters, setSearchFilters] = useState({
    category: "all",
    college: "all",
    major: "all",
    language: "all",
    campus: "all",
    credits: "",
    timeOfDay: "all",
    days: [],
    minRating: "all",
  });

  const [resultFilters, setResultFilters] = useState({
    college: "all",
    major: "all",
    language: "all",
    campus: "all",
    credits: "all",
    timeOfDay: "all",
    days: [],
    minRating: "all",
  });

  // ============================================================
  // AUTH
  // ============================================================
  useEffect(() => {
    setUser(auth.me());
  }, []);

  // ============================================================
  // STATIC LOOKUPS
  // ============================================================
  const DAY_NAME_TO_INDEX = useMemo(
    () => ({
      Monday: 1,
      Tuesday: 2,
      Wednesday: 3,
      Thursday: 4,
      Friday: 5,
      Saturday: 6,
      Sunday: 7,
    }),
    []
  );

  const CAMPUS_LOOKUP = useMemo(
    () => ({
      1: "HSSC",
      2: "NSC",
      3: "iCampus",
    }),
    []
  );

  // ============================================================
  // LOAD FILTER DATA
  // ============================================================
  useEffect(() => {
    const fetchCategories = async () => {
      try {
        const res = await fetch(`${baseUrl}/courses/categories`, {
          headers: { "Content-Type": "application/json", Accept: "application/json" },
        });
        if (!res.ok) throw new Error(`Failed to load categories (${res.status})`);
        const data = await res.json();
        setCategories(data || []);
      } catch (err) {
        console.error("Error fetching categories", err);
      }
    };

    const fetchColleges = async () => {
      try {
        const res = await fetch(`${baseUrl}/courses/colleges`, {
          headers: { "Content-Type": "application/json", Accept: "application/json" },
        });
        if (!res.ok) throw new Error(`Failed to load colleges (${res.status})`);
        const data = await res.json();
        setColleges(data || []);
      } catch (err) {
        console.error("Error fetching colleges", err);
      }
    };

    fetchCategories();
    fetchColleges();
  }, [baseUrl]);

  useEffect(() => {
    const fetchMajors = async () => {
      if (searchFilters.college === "all") {
        setMajors([]);
        setSearchFilters((prev) => ({ ...prev, major: "all" }));
        return;
      }
      try {
        const res = await fetch(
          `${baseUrl}/courses/colleges/${searchFilters.college}/majors`,
          { headers: { "Content-Type": "application/json", Accept: "application/json" } }
        );
        if (!res.ok) throw new Error(`Failed to load majors (${res.status})`);
        const data = await res.json();
        setMajors(data || []);
      } catch (err) {
        console.error("Error fetching majors", err);
      }
    };

    fetchMajors();
  }, [baseUrl, searchFilters.college]);

  // ============================================================
  // LOAD DATA (React Query)
  // ============================================================
  const { data: catalog = [] } = useQuery({
    queryKey: ["catalog"],
    queryFn: () => Catalog.list(),
  });

  const { data: allReviews = [] } = useQuery({
    queryKey: ["reviews"],
    queryFn: () => Reviews.list(),
  });

  const { data: registrations = [] } = useQuery({
    queryKey: ["registrations"],
    queryFn: () => Registration.list(),
  });

  // ============================================================
  // HELPERS
  // ============================================================
  const getCourseReviews = useCallback(
    (courseId) => allReviews.filter((r) => r.course_id === courseId),
    [allReviews]
  );

  const getCourseAvgRating = useCallback(
    (courseId) => {
      const rev = allReviews.filter((r) => r.course_id === courseId);
      if (rev.length === 0) return 0;
      return rev.reduce((s, r) => s + r.rating, 0) / rev.length;
    },
    [allReviews]
  );

  const isInCatalog = useCallback(
    (courseId) => catalog.some((c) => c.course_id === courseId),
    [catalog]
  );

  const getCatalogItem = useCallback(
    (courseId) => catalog.find((c) => c.course_id === courseId),
    [catalog]
  );

  const getTimeOfDay = (course) => {
    if (!course.schedule?.length) return "unknown";
    const hour = parseInt(course.schedule[0].start_time.split(":")[0] || "0", 10);
    if (hour < 12) return "morning";
    if (hour < 17) return "afternoon";
    return "evening";
  };

  const courseMeetsDays = (course, selectedDays) => {
    if (selectedDays.length === 0) return true;
    return course.schedule?.some((slot) => selectedDays.includes(slot.day));
  };

  const normalizeCourse = useCallback(
    (course) => {
      const code = course.courseCode;
      const shortCode = course.shortCourseCode;

      const placements = course.timeRoomPlacements || [];

      const majorsData = (course.majors || []).map((m) => ({
        id: m.id,
        name: m.major_name,
        collegeId: m.college_id,
      }));

      const majorNames = majorsData.map((m) => m.name).filter(Boolean);
      const collegeIds = majorsData.map((m) => m.collegeId).filter(Boolean);

      const schedule = placements.map((slot) => ({
        day:
          ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"][
            (slot.day_of_week ?? 1) - 1
          ] || "Monday",
        start_time: (slot.start_time ?? "").toString().slice(0, 5),
        end_time: (slot.end_time ?? "").toString().slice(0, 5),
        room: slot.classroom || "TBD",
      }));

      return {
        id: course.id || code,
        code,
        base_code: shortCode,
        name: course.name_english || course.name_korean || code,
        description: course.description_english || course.description_korean || "",
        campus: CAMPUS_LOOKUP[course.campus] || "Unknown",
        course_language: course.course_language || course.courseLanguage || null,
        credits: Number(course.credits) || 0,
        schedule,
        instructor:
          (course.instructor && course.instructor.instructor_name) ||
          (course.instructor_id ? `Instructor ${course.instructor_id}` : "TBD"),
        majors: majorsData,
        majorNames,
        collegeIds,
        majorLabel: majorNames[0] || course.category || "General",
        enrolled: course.enrolled || 0,
        capacity: course.capacity || 0,
      };
    },
    [CAMPUS_LOOKUP]
  );

  // ============================================================
  // SEARCH
  // ============================================================
  const handleSearch = useCallback(async () => {
    setIsSearching(true);

    try {
      const courseLanguage =
        searchFilters.language !== "all"
          ? LANGUAGE_OPTIONS.find((o) => o.label === searchFilters.language)?.value ||
            searchFilters.language
          : null;

      const payload = {
        searchTerm: searchTerm || "",
        category: searchFilters.category !== "all" ? searchFilters.category : null,
        collegeId: searchFilters.college !== "all" ? Number(searchFilters.college) : null,
        majorId: searchFilters.major !== "all" ? Number(searchFilters.major) : null,
        courseLanguage,
        credits: searchFilters.credits ? Number(searchFilters.credits) : 0,
        daysOfWeek: (searchFilters.days || [])
          .map((d) => DAY_NAME_TO_INDEX[d])
          .filter((v) => v !== undefined),
        campus:
          searchFilters.campus === "HSSC"
            ? 1
            : searchFilters.campus === "NSC"
            ? 2
            : searchFilters.campus === "iCampus"
            ? 3
            : 0,
        timeOfDay:
          searchFilters.timeOfDay !== "all" ? searchFilters.timeOfDay.toUpperCase() : "ALL",
      };

      const res = await fetch(`${baseUrl}/courses/search`, {
        method: "POST",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify(payload),
      });

      if (!res.ok) throw new Error(`Search failed (${res.status})`);
      const data = await res.json();

      const flattened = Object.values(data || {}).flat();
      const normalized = flattened.map(normalizeCourse);

      setAllCourses(normalized);

      // UX: user Search Filtersda rating tanlasa, natijada ham shuni ko‘rsin
      setResultFilters((prev) => ({
        ...prev,
        minRating: searchFilters.minRating,
      }));
    } catch (err) {
      console.error("Error searching courses", err);
      setAllCourses([]);
    } finally {
      setIsSearching(false);
    }
  }, [
    baseUrl,
    DAY_NAME_TO_INDEX,
    LANGUAGE_OPTIONS,
    normalizeCourse,
    searchFilters,
    searchTerm,
  ]);

  // ✅ MUHIM: page ochilganda avtomatik qidiruv (kurslar ro‘yxati chiqishi uchun)
  useEffect(() => {
    handleSearch();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  // ============================================================
  // MUTATIONS
  // ============================================================
  const addToCatalog = useMutation({
    mutationFn: (course) =>
      Catalog.add({
        course_id: course.id,
        course_code: course.code,
        course_name: course.name,
        base_code: course.base_code,
      }),
    onSuccess: () => queryClient.invalidateQueries(["catalog"]),
  });

  const removeFromCatalog = useMutation({
    mutationFn: (id) => Catalog.remove(id),
    onSuccess: () => queryClient.invalidateQueries(["catalog"]),
  });

  const submitReview = useMutation({
    mutationFn: (reviewData) =>
      Reviews.add({
        course_id: selectedCourse.id,
        course_code: selectedCourse.code,
        reviewer_name: user?.full_name || "Anonymous",
        ...reviewData,
      }),
    onSuccess: () => {
      queryClient.invalidateQueries(["reviews"]);
      setRatingDialogOpen(false);
      setSelectedCourse(null);
    },
  });

  // ============================================================
  // FILTERING (client-side)
  // ============================================================
  const majorOptions = useMemo(() => {
    return [
      ...new Set(
        allCourses
          .flatMap((c) => c.majorNames || [])
          .concat(allCourses.map((c) => c.majorLabel))
      ),
    ].filter(Boolean);
  }, [allCourses]);

  const creditOptions = useMemo(() => {
    return [...new Set(allCourses.map((c) => c.credits))].sort((a, b) => a - b);
  }, [allCourses]);

  const filteredCourses = useMemo(() => {
    return allCourses.filter((course) => {
      const matchesCollege =
        resultFilters.college === "all" ||
        (course.collegeIds || []).includes(Number(resultFilters.college));

      const matchesMajor =
        resultFilters.major === "all" ||
        (course.majorNames || []).includes(resultFilters.major) ||
        course.majorLabel === resultFilters.major;

      const matchesLanguage =
        resultFilters.language === "all" ||
        LANGUAGE_OPTIONS.some(
          (opt) => opt.label === resultFilters.language && opt.value === course.course_language
        );

      const matchesCampus =
        resultFilters.campus === "all" || course.campus === resultFilters.campus;

      const matchesCredits =
        resultFilters.credits === "all" || course.credits === Number(resultFilters.credits);

      const matchesTime =
        resultFilters.timeOfDay === "all" || getTimeOfDay(course) === resultFilters.timeOfDay;

      const matchesDays = courseMeetsDays(course, resultFilters.days);

      const avgRating = getCourseAvgRating(course.id);
      const matchesRating =
        resultFilters.minRating === "all" || avgRating >= Number(resultFilters.minRating);

      return (
        matchesCollege &&
        matchesMajor &&
        matchesLanguage &&
        matchesCampus &&
        matchesCredits &&
        matchesTime &&
        matchesDays &&
        matchesRating
      );
    });
  }, [allCourses, resultFilters, LANGUAGE_OPTIONS, getCourseAvgRating]);

  const groupedCourses = useMemo(() => {
    const g = {};
    filteredCourses.forEach((course) => {
      if (!g[course.base_code]) g[course.base_code] = [];
      g[course.base_code].push(course);
    });
    return g;
  }, [filteredCourses]);

  // ============================================================
  // POPULAR COMBINATIONS
  // ============================================================
  const popularCombinations = useMemo(() => {
    const combinations = {};
    const byUser = {};

    registrations.forEach((r) => {
      if (!r.created_by) return;
      if (!byUser[r.created_by]) byUser[r.created_by] = new Set();
      byUser[r.created_by].add(r.course_code);
    });

    for (const u in byUser) {
      const codes = [...byUser[u]];
      for (let i = 0; i < codes.length; i++) {
        for (let j = i + 1; j < codes.length; j++) {
          const key = [codes[i], codes[j]].sort().join("-");
          combinations[key] = (combinations[key] || 0) + 1;
        }
      }
    }

    return Object.entries(combinations)
      .sort((a, b) => b[1] - a[1])
      .slice(0, 5)
      .map(([key, count]) => {
        const [a, b] = key.split("-");
        return { code1: a, code2: b, count };
      });
  }, [registrations]);

  const activeSearchFilters = useMemo(
    () =>
      [
        searchFilters.category !== "all",
        searchFilters.college !== "all",
        searchFilters.major !== "all",
        searchFilters.language !== "all",
        searchFilters.campus !== "all",
        !!searchFilters.credits,
        searchFilters.timeOfDay !== "all",
        searchFilters.days.length > 0,
        searchFilters.minRating !== "all",
      ].filter(Boolean).length,
    [searchFilters]
  );

  const activeResultFilters = useMemo(
    () =>
      [
        resultFilters.college !== "all",
        resultFilters.major !== "all",
        resultFilters.language !== "all",
        resultFilters.campus !== "all",
        resultFilters.credits !== "all",
        resultFilters.timeOfDay !== "all",
        resultFilters.days.length > 0,
        resultFilters.minRating !== "all",
      ].filter(Boolean).length,
    [resultFilters]
  );

  const clearSearchFilters = () => {
    setMajors([]);
    setSearchFilters({
      category: "all",
      college: "all",
      major: "all",
      language: "all",
      campus: "all",
      credits: "",
      timeOfDay: "all",
      days: [],
      minRating: "all",
    });
  };

  const clearResultFilters = () => {
    setResultFilters({
      college: "all",
      major: "all",
      language: "all",
      campus: "all",
      credits: "all",
      timeOfDay: "all",
      days: [],
      minRating: "all",
    });
  };

  // ============================================================
  // UI
  // ============================================================
  const resultsCount = Object.keys(groupedCourses).length;

  return (
    <div className="min-h-screen bg-gradient-to-b from-emerald-50/40 to-white">
      <div className="max-w-7xl mx-auto p-4 md:p-8 space-y-6">
        {/* TITLE */}
        <div className="flex flex-col gap-1">
          <h1 className="text-3xl md:text-4xl font-bold text-gray-900 tracking-tight">
            Course Catalog
          </h1>
          <p className="text-gray-600">
            Browse, rate, and add courses to your schedule
          </p>
        </div>

        {/* POPULAR COMBINATIONS */}
        {popularCombinations.length > 0 && (
          <Card className="p-5 md:p-6 border border-emerald-200 bg-white/80 backdrop-blur rounded-2xl shadow-sm">
            <div className="flex items-center gap-2 mb-3">
              <TrendingUp className="w-5 h-5 text-emerald-600" />
              <h3 className="text-lg font-semibold text-gray-900">
                Popular Course Combinations
              </h3>
            </div>

            <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
              {popularCombinations.map((pair, idx) => (
                <div
                  key={idx}
                  className="p-4 rounded-xl border border-emerald-200 bg-emerald-50/40 text-center"
                >
                  <p className="font-bold">{pair.code1}</p>
                  <p className="text-emerald-600 text-sm">+</p>
                  <p className="font-bold">{pair.code2}</p>
                  <Badge className="mt-2 bg-emerald-100 text-emerald-700 text-xs">
                    {pair.count} students
                  </Badge>
                </div>
              ))}
            </div>
          </Card>
        )}

        {/* SEARCH + FILTERS */}
        <Card className="p-4 md:p-5 rounded-2xl border border-emerald-200 bg-white/80 backdrop-blur shadow-sm">
          <div className="flex flex-col md:flex-row gap-3">
            <div className="relative flex-1">
              <Search className="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 w-5 h-5" />
              <Input
                placeholder="Search by course name, code, or instructor..."
                className="pl-10 rounded-xl bg-white"
                value={searchTerm}
                onChange={(e) => setSearchTerm(e.target.value)}
                onKeyDown={(e) => {
                  if (e.key === "Enter") handleSearch();
                }}
              />
            </div>

            <Button
              className="rounded-xl bg-emerald-600 hover:bg-emerald-700"
              onClick={handleSearch}
              disabled={isSearching}
            >
              <Search className="w-4 h-4 mr-2" />
              {isSearching ? "Searching..." : "Search"}
            </Button>

            <Button
              variant="outline"
              className="rounded-xl border-emerald-300 text-emerald-800 hover:bg-emerald-50"
              onClick={() => setShowSearchFilters((s) => !s)}
            >
              <Filter className="w-4 h-4 mr-2" /> Search Filters
              {activeSearchFilters > 0 && ` (${activeSearchFilters})`}
            </Button>
          </div>

          {/* FILTER PANEL */}
          {showSearchFilters && (
            <div className="mt-4">
              <div className="flex justify-between items-center mb-4">
                <h3 className="text-base font-semibold">Search Filters</h3>
                <Button variant="ghost" onClick={clearSearchFilters}>
                  <X className="w-4 h-4 mr-2" /> Clear
                </Button>
              </div>

              <div className="grid md:grid-cols-2 lg:grid-cols-8 gap-4">
                {/* Category */}
                <div>
                  <label className="text-sm font-medium">Category</label>
                  <Select
                    value={searchFilters.category}
                    onValueChange={(v) => setSearchFilters((f) => ({ ...f, category: v }))}
                  >
                    <SelectTrigger className="rounded-xl bg-white">
                      <SelectValue placeholder="Select" />
                    </SelectTrigger>
                    <SelectContent className="max-h-60 overflow-y-auto">
                      <SelectItem value="all">All</SelectItem>
                      {categories.map((cat) => (
                        <SelectItem key={cat} value={cat}>
                          {cat}
                        </SelectItem>
                      ))}
                    </SelectContent>
                  </Select>
                </div>

                {/* College */}
                <div>
                  <label className="text-sm font-medium">College</label>
                  <Select
                    value={searchFilters.college}
                    onValueChange={(v) =>
                      setSearchFilters((f) => ({ ...f, college: v, major: "all" }))
                    }
                  >
                    <SelectTrigger className="rounded-xl bg-white">
                      <SelectValue placeholder="Select" />
                    </SelectTrigger>
                    <SelectContent className="max-h-60 overflow-y-auto">
                      <SelectItem value="all">All</SelectItem>
                      {colleges.map((c) => (
                        <SelectItem key={c.id} value={String(c.id)}>
                          {c.name || c.college_name || c.collegeName}
                        </SelectItem>
                      ))}
                    </SelectContent>
                  </Select>
                </div>

                {/* Major */}
                <div>
                  <label className="text-sm font-medium">Major</label>
                  <Select
                    value={searchFilters.major}
                    onValueChange={(v) => setSearchFilters((f) => ({ ...f, major: v }))}
                  >
                    <SelectTrigger className="rounded-xl bg-white" disabled={majors.length === 0}>
                      <SelectValue placeholder="Select" />
                    </SelectTrigger>
                    <SelectContent className="max-h-60 overflow-y-auto">
                      <SelectItem value="all">All</SelectItem>
                      {majors.map((m) => (
                        <SelectItem key={m.id} value={String(m.id)}>
                          {m.name || m.major_name || m.majorName}
                        </SelectItem>
                      ))}
                    </SelectContent>
                  </Select>
                </div>

                {/* Language */}
                <div>
                  <label className="text-sm font-medium">Language</label>
                  <Select
                    value={searchFilters.language}
                    onValueChange={(v) => setSearchFilters((f) => ({ ...f, language: v }))}
                  >
                    <SelectTrigger className="rounded-xl bg-white">
                      <SelectValue placeholder="Any" />
                    </SelectTrigger>
                    <SelectContent className="max-h-60 overflow-y-auto">
                      <SelectItem value="all">Any</SelectItem>
                      {LANGUAGE_OPTIONS.map((opt) => (
                        <SelectItem key={opt.label} value={opt.label}>
                          {opt.label}
                        </SelectItem>
                      ))}
                    </SelectContent>
                  </Select>
                </div>

                {/* Campus */}
                <div>
                  <label className="text-sm font-medium">Campus</label>
                  <Select
                    value={searchFilters.campus}
                    onValueChange={(v) => setSearchFilters((f) => ({ ...f, campus: v }))}
                  >
                    <SelectTrigger className="rounded-xl bg-white">
                      <SelectValue placeholder="Select" />
                    </SelectTrigger>
                    <SelectContent>
                      <SelectItem value="all">All</SelectItem>
                      <SelectItem value="HSSC">HSSC</SelectItem>
                      <SelectItem value="NSC">NSC</SelectItem>
                      <SelectItem value="iCampus">iCampus</SelectItem>
                    </SelectContent>
                  </Select>
                </div>

                {/* Credits */}
                <div>
                  <label className="text-sm font-medium">Credits</label>
                  <Input
                    type="text"
                    placeholder="e.g. 3"
                    value={searchFilters.credits}
                    onChange={(e) => setSearchFilters((f) => ({ ...f, credits: e.target.value }))}
                    className="rounded-xl bg-white"
                  />
                </div>

                {/* Time of Day */}
                <div>
                  <label className="text-sm font-medium">Time</label>
                  <Select
                    value={searchFilters.timeOfDay}
                    onValueChange={(v) => setSearchFilters((f) => ({ ...f, timeOfDay: v }))}
                  >
                    <SelectTrigger className="rounded-xl bg-white">
                      <SelectValue placeholder="Any" />
                    </SelectTrigger>
                    <SelectContent>
                      <SelectItem value="all">Any</SelectItem>
                      <SelectItem value="morning">Morning</SelectItem>
                      <SelectItem value="afternoon">Afternoon</SelectItem>
                      <SelectItem value="evening">Evening</SelectItem>
                    </SelectContent>
                  </Select>
                </div>

                {/* Rating */}
                <div>
                  <label className="text-sm font-medium">Rating</label>
                  <Select
                    value={searchFilters.minRating}
                    onValueChange={(v) => setSearchFilters((f) => ({ ...f, minRating: v }))}
                  >
                    <SelectTrigger className="rounded-xl bg-white">
                      <SelectValue placeholder="Any" />
                    </SelectTrigger>
                    <SelectContent>
                      <SelectItem value="all">Any</SelectItem>
                      <SelectItem value="4">4★+</SelectItem>
                      <SelectItem value="3">3★+</SelectItem>
                      <SelectItem value="2">2★+</SelectItem>
                    </SelectContent>
                  </Select>
                </div>
              </div>

              {/* DAYS */}
              <div className="mt-4">
                <label className="text-sm font-medium">Days</label>
                <div className="flex flex-wrap gap-3 mt-2">
                  {["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"].map(
                    (d) => (
                      <label key={d} className="flex items-center gap-2">
                        <Checkbox
                          checked={searchFilters.days.includes(d)}
                          onCheckedChange={(checked) =>
                            setSearchFilters((prev) => ({
                              ...prev,
                              days: checked
                                ? [...prev.days, d]
                                : prev.days.filter((x) => x !== d),
                            }))
                          }
                        />
                        <span className="text-sm">{d}</span>
                      </label>
                    )
                  )}
                </div>
              </div>
            </div>
          )}
        </Card>

        {/* STATS + RESULT FILTERS */}
        <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
          <Card className="p-5 rounded-2xl border border-emerald-200 bg-white shadow-sm">
            <div className="flex items-center gap-3">
              <div className="p-2 rounded-xl bg-emerald-50 border border-emerald-100">
                <BookOpen className="w-5 h-5 text-emerald-700" />
              </div>
              <div>
                <p className="text-2xl font-bold text-gray-900">{resultsCount}</p>
                <p className="text-sm text-gray-600">Search Results</p>
              </div>
            </div>
          </Card>

          <Card className="p-5 rounded-2xl border border-emerald-200 bg-white shadow-sm">
            <div className="flex items-center gap-3">
              <div className="p-2 rounded-xl bg-emerald-50 border border-emerald-100">
                <Plus className="w-5 h-5 text-emerald-700" />
              </div>
              <div>
                <p className="text-2xl font-bold text-gray-900">{catalog.length}</p>
                <p className="text-sm text-gray-600">In Your Catalog</p>
              </div>
            </div>
          </Card>

          <Card className="p-5 rounded-2xl border border-emerald-200 bg-white shadow-sm flex items-center justify-between">
            <div>
              <p className="text-sm text-gray-600">Refine results</p>
              <p className="text-base font-semibold text-gray-900">Result Filters</p>
            </div>
            <Button
              variant="outline"
              className="rounded-xl border-emerald-300 text-emerald-800 hover:bg-emerald-50"
              onClick={() => setShowResultFilters((s) => !s)}
            >
              <Filter className="w-4 h-4 mr-2" />
              {activeResultFilters > 0 ? `(${activeResultFilters})` : "Open"}
            </Button>
          </Card>
        </div>

        {/* RESULT FILTER PANEL */}
        {showResultFilters && (
          <Card className="p-5 rounded-2xl border border-emerald-200 bg-white shadow-sm">
            <div className="flex justify-between items-center mb-4">
              <h3 className="text-base font-semibold">Filter Found Results</h3>
              <Button variant="ghost" onClick={clearResultFilters}>
                <X className="w-4 h-4 mr-2" /> Clear
              </Button>
            </div>

            <div className="grid md:grid-cols-2 lg:grid-cols-7 gap-4">
              <div>
                <label className="text-sm font-medium">College</label>
                <Select
                  value={resultFilters.college}
                  onValueChange={(v) => setResultFilters((f) => ({ ...f, college: v }))}
                >
                  <SelectTrigger className="rounded-xl bg-white">
                    <SelectValue placeholder="Select" />
                  </SelectTrigger>
                  <SelectContent className="max-h-60 overflow-y-auto">
                    <SelectItem value="all">All</SelectItem>
                    {colleges.map((c) => (
                      <SelectItem key={c.id} value={String(c.id)}>
                        {c.name || c.college_name || c.collegeName}
                      </SelectItem>
                    ))}
                  </SelectContent>
                </Select>
              </div>

              <div>
                <label className="text-sm font-medium">Major</label>
                <Select
                  value={resultFilters.major}
                  onValueChange={(v) => setResultFilters((f) => ({ ...f, major: v }))}
                >
                  <SelectTrigger className="rounded-xl bg-white">
                    <SelectValue placeholder="Select" />
                  </SelectTrigger>
                  <SelectContent className="max-h-60 overflow-y-auto">
                    <SelectItem value="all">All</SelectItem>
                    {majorOptions.map((m) => (
                      <SelectItem key={m} value={m}>
                        {m}
                      </SelectItem>
                    ))}
                  </SelectContent>
                </Select>
              </div>

              <div>
                <label className="text-sm font-medium">Language</label>
                <Select
                  value={resultFilters.language}
                  onValueChange={(v) => setResultFilters((f) => ({ ...f, language: v }))}
                >
                  <SelectTrigger className="rounded-xl bg-white">
                    <SelectValue placeholder="Any" />
                  </SelectTrigger>
                  <SelectContent className="max-h-60 overflow-y-auto">
                    <SelectItem value="all">Any</SelectItem>
                    {LANGUAGE_OPTIONS.map((opt) => (
                      <SelectItem key={opt.label} value={opt.label}>
                        {opt.label}
                      </SelectItem>
                    ))}
                  </SelectContent>
                </Select>
              </div>

              <div>
                <label className="text-sm font-medium">Campus</label>
                <Select
                  value={resultFilters.campus}
                  onValueChange={(v) => setResultFilters((f) => ({ ...f, campus: v }))}
                >
                  <SelectTrigger className="rounded-xl bg-white">
                    <SelectValue placeholder="Select" />
                  </SelectTrigger>
                  <SelectContent>
                    <SelectItem value="all">All</SelectItem>
                    <SelectItem value="HSSC">HSSC</SelectItem>
                    <SelectItem value="NSC">NSC</SelectItem>
                    <SelectItem value="iCampus">iCampus</SelectItem>
                  </SelectContent>
                </Select>
              </div>

              <div>
                <label className="text-sm font-medium">Credits</label>
                <Select
                  value={resultFilters.credits}
                  onValueChange={(v) => setResultFilters((f) => ({ ...f, credits: v }))}
                >
                  <SelectTrigger className="rounded-xl bg-white">
                    <SelectValue placeholder="Select" />
                  </SelectTrigger>
                  <SelectContent>
                    <SelectItem value="all">All</SelectItem>
                    {creditOptions.map((c) => (
                      <SelectItem key={c} value={String(c)}>
                        {c} Credits
                      </SelectItem>
                    ))}
                  </SelectContent>
                </Select>
              </div>

              <div>
                <label className="text-sm font-medium">Time</label>
                <Select
                  value={resultFilters.timeOfDay}
                  onValueChange={(v) => setResultFilters((f) => ({ ...f, timeOfDay: v }))}
                >
                  <SelectTrigger className="rounded-xl bg-white">
                    <SelectValue placeholder="Any" />
                  </SelectTrigger>
                  <SelectContent>
                    <SelectItem value="all">Any</SelectItem>
                    <SelectItem value="morning">Morning</SelectItem>
                    <SelectItem value="afternoon">Afternoon</SelectItem>
                    <SelectItem value="evening">Evening</SelectItem>
                  </SelectContent>
                </Select>
              </div>

              <div>
                <label className="text-sm font-medium">Rating</label>
                <Select
                  value={resultFilters.minRating}
                  onValueChange={(v) => setResultFilters((f) => ({ ...f, minRating: v }))}
                >
                  <SelectTrigger className="rounded-xl bg-white">
                    <SelectValue placeholder="Any" />
                  </SelectTrigger>
                  <SelectContent>
                    <SelectItem value="all">Any</SelectItem>
                    <SelectItem value="4">4★+</SelectItem>
                    <SelectItem value="3">3★+</SelectItem>
                    <SelectItem value="2">2★+</SelectItem>
                  </SelectContent>
                </Select>
              </div>
            </div>

            <div className="mt-4">
              <label className="text-sm font-medium">Days</label>
              <div className="flex flex-wrap gap-3 mt-2">
                {["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"].map(
                  (d) => (
                    <label key={d} className="flex items-center gap-2">
                      <Checkbox
                        checked={resultFilters.days.includes(d)}
                        onCheckedChange={(checked) =>
                          setResultFilters((prev) => ({
                            ...prev,
                            days: checked
                              ? [...prev.days, d]
                              : prev.days.filter((x) => x !== d),
                          }))
                        }
                      />
                      <span className="text-sm">{d}</span>
                    </label>
                  )
                )}
              </div>
            </div>
          </Card>
        )}

        {/* EMPTY / LOADING */}
        {isSearching && (
          <Card className="p-6 rounded-2xl border border-emerald-200 bg-white shadow-sm">
            <p className="text-gray-700 font-medium">Searching courses...</p>
            <p className="text-sm text-gray-500 mt-1">
              Backend response kelishi bilan ro‘yxat chiqadi.
            </p>
          </Card>
        )}

        {!isSearching && resultsCount === 0 && (
          <Card className="p-6 rounded-2xl border border-emerald-200 bg-white shadow-sm">
            <p className="text-gray-900 font-semibold">No courses found</p>
            <p className="text-sm text-gray-600 mt-1">
              Filterlarni yengillashtiring yoki qidiruv so‘zini o‘zgartiring.
            </p>
          </Card>
        )}

        {/* COURSE LIST */}
        {!isSearching && resultsCount > 0 && (
          <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
            {Object.entries(groupedCourses).map(([baseCode, sections]) => {
              const first = sections[0];
              const avgRating = getCourseAvgRating(first.id);
              const courseReviews = getCourseReviews(first.id);

              return (
                <Card
                  key={baseCode}
                  className="p-6 rounded-2xl border border-emerald-200 bg-white shadow-sm hover:shadow-md transition-shadow"
                >
                  <div className="flex justify-between items-start gap-4">
                    <div className="min-w-0">
                      <div className="flex flex-wrap items-center gap-2 mb-1">
                        <h3 className="font-bold text-xl text-gray-900">{baseCode}</h3>

                        <Badge className="bg-emerald-600 text-white px-2">
                          {first.credits} Credits
                        </Badge>

                        <Badge variant="outline" className="px-2">
                          {first.majorLabel}
                        </Badge>

                        {avgRating > 0 && (
                          <Badge className="bg-yellow-200 text-yellow-800 border-yellow-400 flex items-center px-2">
                            <Star className="w-3 h-3 mr-1 fill-yellow-600" />
                            {avgRating.toFixed(1)}
                          </Badge>
                        )}
                      </div>

                      <h4 className="text-gray-900 font-semibold truncate">{first.name}</h4>
                      <p className="text-sm text-gray-600 line-clamp-2">{first.description}</p>
                    </div>

                    <div className="flex gap-2 shrink-0">
                      <Button
                        size="sm"
                        variant="outline"
                        className="rounded-xl"
                        onClick={() => {
                          setSelectedCourse(first);
                          setDetailDialogOpen(true);
                        }}
                      >
                        <Info className="w-4 h-4 mr-1" /> Details
                      </Button>

                      <Button
                        size="sm"
                        className="rounded-xl bg-emerald-600 hover:bg-emerald-700"
                        onClick={() => {
                          setSelectedCourse(first);
                          setRatingDialogOpen(true);
                        }}
                      >
                        <Star className="w-4 h-4 mr-1" /> Rate
                      </Button>
                    </div>
                  </div>

                  {courseReviews.length > 0 && (
                    <div className="border-t mt-4 pt-3">
                      <CourseRatings reviews={courseReviews} />
                    </div>
                  )}

                  <p className="text-xs font-semibold text-gray-700 mt-5 mb-2 uppercase tracking-wide">
                    Sections ({sections.length})
                  </p>

                  <div className="space-y-3">
                    {sections.map((sec) => {
                      const inCatalog = isInCatalog(sec.id);

                      return (
                        <div
                          key={sec.id}
                          className="flex items-center justify-between gap-4 p-4 rounded-xl border bg-gray-50 hover:border-emerald-300 transition-colors"
                        >
                          <div className="flex-1 min-w-0">
                            <p className="font-semibold text-sm text-gray-900">{sec.code}</p>

                            <div className="flex gap-2 text-xs text-gray-600 mt-1 flex-wrap">
                              <Badge variant="outline" className="flex items-center">
                                <MapPin className="w-3 h-3 mr-1" />
                                {sec.campus}
                              </Badge>

                              <Badge variant="outline" className="flex items-center">
                                <Users className="w-3 h-3 mr-1" />
                                {sec.enrolled}/{sec.capacity}
                              </Badge>
                            </div>

                            <p className="text-xs text-gray-600 mt-1 truncate">{sec.instructor}</p>

                            <div className="flex flex-wrap gap-2 mt-1 text-xs text-gray-500">
                              {(sec.schedule || []).map((slot, i) => (
                                <span key={i}>
                                  {slot.day.slice(0, 3)} {slot.start_time}-{slot.end_time}
                                </span>
                              ))}
                            </div>
                          </div>

                          <Button
                            size="sm"
                            className={`rounded-xl px-4 ${
                              inCatalog
                                ? "bg-green-600 hover:bg-green-700"
                                : "bg-emerald-600 hover:bg-emerald-700"
                            }`}
                            onClick={() => {
                              const item = getCatalogItem(sec.id);
                              if (item) removeFromCatalog.mutate(item.id);
                              else addToCatalog.mutate(sec);
                            }}
                          >
                            {inCatalog ? (
                              <>
                                <Check className="w-4 h-4 mr-1" />
                                Added
                              </>
                            ) : (
                              <>
                                <Plus className="w-4 h-4 mr-1" />
                                Add
                              </>
                            )}
                          </Button>
                        </div>
                      );
                    })}
                  </div>
                </Card>
              );
            })}
          </div>
        )}

        {/* CHATBOT + DIALOGS */}
        <AIChatbot allCourses={allCourses} />

        <RatingDialog
          course={selectedCourse}
          open={ratingDialogOpen}
          onOpenChange={setRatingDialogOpen}
          onSubmit={(data) => submitReview.mutate(data)}
          isSubmitting={submitReview.isPending}
        />

        <CourseDetailDialog
          course={selectedCourse}
          open={detailDialogOpen}
          onOpenChange={setDetailDialogOpen}
          allCourses={allCourses}
        />
      </div>
    </div>
  );
}

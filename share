import React, { useState, useEffect, useMemo } from "react";
import { useQuery, useMutation, useQueryClient } from "@tanstack/react-query";

// UI Components (Ensure these are correctly mapped in your project)
import { Button } from "@/components/ui/button";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from "@/components/ui/select";
import { Card, CardContent } from "@/components/ui/card"; // Used for better structure

// Icons & Utils
import { AlertTriangle, LayoutGrid, Trash2, Calendar, Search, GraduationCap } from "lucide-react";
import { Link } from "react-router-dom";
import { createPageUrl } from "@/utils";

// Local API/Mocks
import { Catalog } from "@/localApi/catalog";
import { Course } from "@/localApi/courses";
import { Registration } from "@/localApi/registration";
import { SavedSchedule } from "@/localApi/savedSchedule";
// import { Preference } from "@/localApi/preferences"; // Not used, removed for clarity

// Internal Components
import CourseSelection from "../components/registration/CourseSelection";
import WeeklyTimetable from "../components/registration/WeeklyTimetable";
import SelectedCourses from "../components/registration/SelectedCourses";

export default function RegistrationPage() {
  const [selectedBaseCode, setSelectedBaseCode] = useState(null);
  const [warning, setWarning] = useState(null);
  const [activeSchedule, setActiveSchedule] = useState(null);

  const queryClient = useQueryClient();

  /** -------------------------
   * DATA FETCHING (useQuery)
   * ------------------------- */
  const { data: allCourses = [], isLoading: coursesLoading } = useQuery({
    queryKey: ["courses"],
    queryFn: () => Course.list(),
  });

  const { data: catalog = [], isLoading: catalogLoading } = useQuery({
    queryKey: ["catalog"],
    queryFn: () => Catalog.list(),
  });

  const { data: savedSchedules = [], isLoading: schedulesLoading } = useQuery({
    queryKey: ["savedSchedules"],
    queryFn: () => SavedSchedule.list(),
  });
  
  const { data: registrations = [], isLoading: registrationLoading } = useQuery({
    queryKey: ["registrations"],
    queryFn: () => Registration.list(),
  });

  // Ensure savedSchedules is treated as an array
  const safeSavedSchedules = useMemo(() => 
    Array.isArray(savedSchedules) ? savedSchedules : Object.values(savedSchedules || {}), 
    [savedSchedules]
  );

  /** -------------------------
   * MUTATIONS
   * ------------------------- */
  const registerMutation = useMutation({
    mutationFn: (course) =>
      Registration.add({
        course_id: course.id,
        course_code: course.code,
        course_name: course.name,
        status: "registered",
      }),
    onSuccess: () => {
      queryClient.invalidateQueries(["registrations"]);
      setWarning(null); // Clear warning on successful registration
    },
  });

  const unregisterMutation = useMutation({
    mutationFn: (id) => Registration.remove(id),
    onSuccess: () => queryClient.invalidateQueries(["registrations"]),
  });

  const removeCatalogMutation = useMutation({
    mutationFn: (id) => Catalog.remove(id),
    onSuccess: () => queryClient.invalidateQueries(["catalog"]),
  });

  const activateScheduleMutation = useMutation({
    mutationFn: (scheduleId) => SavedSchedule.activate(scheduleId),
    onSuccess: () => queryClient.invalidateQueries(["savedSchedules"]),
  });

  const deleteScheduleMutation = useMutation({
    mutationFn: (scheduleId) => SavedSchedule.remove(scheduleId),
    onSuccess: () => queryClient.invalidateQueries(["savedSchedules"]),
  });

  /** -------------------------
   * ACTIVE SCHEDULE / COURSE LISTS LOGIC
   * ------------------------- */

  // Set the active schedule on data load
  useEffect(() => {
    setActiveSchedule(safeSavedSchedules.find((s) => s.is_active) || null);
  }, [safeSavedSchedules]);

  // Use useMemo for computed lists to optimize re-renders
  const catalogCourses = useMemo(() => 
    catalog
      .map((c) => allCourses.find((course) => course.id === c.course_id))
      .filter(Boolean),
    [catalog, allCourses]
  );

  const registeredCourses = useMemo(() => 
    registrations
      .filter((r) => r.status === "registered")
      .map((r) => allCourses.find((c) => c.id === r.course_id))
      .filter(Boolean),
    [registrations, allCourses]
  );
  
  const getAvailableSections = (baseCode) => {
    if (!baseCode) return [];
    return allCourses.filter(
      (c) =>
        c.base_code === baseCode &&
        !registrations.some((r) => r.course_id === c.id && r.status === "registered")
    );
  };

  /** -------------------------
   * CAMPUS CONFLICT CHECKER
   * ------------------------- */

  const checkCampusConflict = (newCourse) => {
    const conflicts = [];
    
    // Check if newCourse has schedule data before iterating
    if (!newCourse.schedule || !registeredCourses.length) return conflicts;

    newCourse.schedule.forEach((newSlot) => {
      registeredCourses.forEach((existing) => {
        // Only check for conflict if campuses are different
        if (existing.campus !== newCourse.campus) {
          existing.schedule?.forEach((oldSlot) => {
            if (oldSlot.day === newSlot.day) {
              // Time parsing helper
              const timeToMinutes = (time) => {
                const [h, m] = time.split(':').map(Number);
                return h * 60 + m;
              };

              const newStartMins = timeToMinutes(newSlot.start_time);
              const oldEndMins = timeToMinutes(oldSlot.end_time);

              // 60 minutes or less travel time conflict
              if (Math.abs(newStartMins - oldEndMins) <= 60) {
                conflicts.push({
                  day: newSlot.day,
                  course1: existing.code,
                  course2: newCourse.code,
                  campus1: existing.campus,
                  campus2: newCourse.campus,
                });
              }
            }
          });
        }
      });
    });
    return conflicts;
  };

  /** -------------------------
   * USER ACTION HANDLERS
   * ------------------------- */

  const handleSelectSection = (course) => {
    if (!course) return;

    // 1. Check if course is already registered
    const isRegistered = registeredCourses.some(c => c.id === course.id);
    if (isRegistered) {
        setWarning(`🛑 Error: You are already registered for ${course.code}.`);
        return;
    }

    // 2. Check for conflicts
    const conflicts = checkCampusConflict(course);

    if (conflicts.length > 0) {
      const c = conflicts[0];
      setWarning(
        `⚠️ Warning: ${c.course1} (${c.campus1}) and ${c.course2} (${c.campus2}) on ${c.day} are too close (less than 1 hour travel time).`
      );
    } else {
      setWarning(null); // Clear previous warnings if successful
    }

    // 3. Register the course
    registerMutation.mutate(course);
  };

  const handleRemoveCourse = (course) => {
    const reg = registrations.find((r) => r.course_id === course.id);
    if (reg) unregisterMutation.mutate(reg.id);
  };

  const handleRemoveFromCatalog = (course) => {
    const item = catalog.find((c) => c.course_id === course.id);
    if (item) removeCatalogMutation.mutate(item.id);
    setSelectedBaseCode(null);
  };

  const handleLoadSchedule = async (scheduleId) => {
    // 1. Activate the new schedule
    await activateScheduleMutation.mutateAsync(scheduleId);

    // 2. Clear current registrations (synchronous approach for UX)
    // Note: In a real backend, this would often be a single API call for efficiency.
    registrations.forEach((r) => unregisterMutation.mutate(r.id));
    
    // 3. Register courses from the new schedule
    const selected = safeSavedSchedules.find((s) => s.id === scheduleId);
    if (selected?.courses) {
      selected.courses.forEach((c) => {
        const course = allCourses.find((k) => k.id === c.course_id);
        if (course) registerMutation.mutate(course);
      });
    }
  };

  /** -------------------------
   * UI / UX
   * ------------------------- */

  // Show loading state if any main data is fetching
  const isDataLoading = coursesLoading || catalogLoading || schedulesLoading || registrationLoading;

  return (
    <div className="min-h-screen bg-slate-50 p-4 md:p-8">
      <div className="max-w-[1600px] mx-auto space-y-8">
        
        {/* HEADER */}
        <header className="flex flex-col md:flex-row justify-between items-start md:items-center bg-white p-6 rounded-3xl border border-slate-100 shadow-lg shadow-slate-200/50">
          <div className="flex items-center gap-4">
            <div className="p-3 bg-emerald-50 rounded-2xl">
              <GraduationCap className="w-8 h-8 text-emerald-600" />
            </div>
            <div>
              <h1 className="text-3xl font-bold tracking-tight text-slate-900">Course Registration</h1>
              <p className="text-slate-500 text-sm">Review your schedule and register for sections.</p>
            </div>
          </div>

          {/* SCHEDULE SELECTOR */}
          {safeSavedSchedules.length > 0 && (
            <div className="flex items-center gap-3 mt-4 md:mt-0 p-1.5 bg-slate-50 rounded-xl border border-slate-100">
              <Calendar className="w-4 h-4 text-slate-500 ml-1" />
              <Select
                value={activeSchedule?.id || ""}
                onValueChange={handleLoadSchedule}
              >
                <SelectTrigger className="w-[200px] bg-transparent border-none text-slate-800 font-medium shadow-none focus:ring-0">
                  <SelectValue placeholder="Load/Select Schedule" />
                </SelectTrigger>
                <SelectContent>
                  {safeSavedSchedules.map((s) => (
                    <SelectItem key={s.id} value={s.id}>
                      {s.name} {s.is_active && "(Active)"}
                    </SelectItem>
                  ))}
                </SelectContent>
              </Select>
              
              {activeSchedule && (
                <Button
                  size="sm"
                  variant="ghost"
                  onClick={() => deleteScheduleMutation.mutate(activeSchedule.id)}
                  className="text-red-600 hover:bg-red-50 rounded-lg"
                >
                  <Trash2 className="w-4 h-4" />
                </Button>
              )}
            </div>
          )}
        </header>

        {/* LOADING STATE / WARNING */}
        {isDataLoading && (
          <Alert className="bg-blue-50 border-blue-200 text-blue-800 rounded-xl">
             <AlertTriangle className="h-5 w-5 text-blue-600 animate-spin" />
             <AlertDescription>Loading course data...</AlertDescription>
          </Alert>
        )}
        
        {warning && (
          <Alert className="mb-6 border-2 border-amber-400 bg-amber-50 rounded-xl shadow-md animate-in fade-in slide-in-from-top-4">
            <AlertTriangle className="h-5 w-5 text-amber-600" />
            <AlertDescription className="text-amber-800 font-semibold">
              {warning}
            </AlertDescription>
          </Alert>
        )}

        {/* MAIN GRID LAYOUT */}
        <div className="grid lg:grid-cols-[380px_1fr] gap-8">
          
          {/* LEFT PANEL */}
          <div className="space-y-8">
            {/* Catalog Card */}
            <Card className="rounded-[1.5rem] border-slate-100 shadow-xl shadow-slate-200/50 overflow-hidden">
              <div className="p-4 border-b border-slate-100 flex flex-row justify-between items-center bg-emerald-600">
                <h3 className="text-xl font-bold text-white flex items-center gap-2">
                  <LayoutGrid className="w-5 h-5 text-emerald-300" /> My Catalog
                </h3>
                <Link to={createPageUrl("Courses")}>
                  <Button size="sm" className="bg-white text-emerald-600 hover:bg-emerald-50 text-sm rounded-lg">
                    Browse +
                  </Button>
                </Link>
              </div>

              <CardContent className="p-4 max-h-[400px] overflow-y-auto bg-white">
                {catalogCourses.length === 0 ? (
                  <div className="text-center py-10">
                    <Search className="w-10 h-10 text-slate-200 mx-auto mb-2" />
                    <p className="text-slate-400 text-sm">No courses added to catalog. Click 'Browse +' above.</p>
                  </div>
                ) : (
                  <CourseSelection
                    catalogCourses={catalogCourses}
                    selectedBaseCode={selectedBaseCode}
                    onSelectBaseCode={setSelectedBaseCode}
                    onRemoveFromCatalog={handleRemoveFromCatalog}
                    registeredCourseIds={registeredCourses.map((c) => c.id)}
                  />
                )}
              </CardContent>
            </Card>

            {/* Registered list */}
            <SelectedCourses
              courses={registeredCourses}
              onRemove={handleRemoveCourse}
            />
          </div>

          {/* RIGHT PANEL — TIMETABLE & SECTIONS */}
          <WeeklyTimetable
            registeredCourses={registeredCourses}
            availableSections={
              selectedBaseCode ? getAvailableSections(selectedBaseCode) : []
            }
            onSelectSection={handleSelectSection}
          />
        </div>
      </div>
    </div>
  );
}

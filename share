import React, { useState, useEffect, useMemo, useCallback } from "react";
import { useQuery, useMutation, useQueryClient } from "@tanstack/react-query";

// Local API
import { AuthApi } from "/src/localApi/auth";
import { Catalog } from "@/localApi/catalog";
import { Registration } from "@/localApi/registration";
import { Reviews } from "@/localApi/reviews";

// UI Components (shadcn)
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Card } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import {
  Search,
  Plus,
  Check,
  MapPin,
  Users,
  BookOpen,
  Filter,
  X,
  Star,
  TrendingUp,
  Info,
  ChevronDown,
  ChevronUp,
  Loader2
} from "lucide-react";

import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";

import { Checkbox } from "@/components/ui/checkbox";

// Dialogs
import RatingDialog from "../components/courses/RatingDialog.jsx";
import CourseRatings from "../components/courses/CourseRatings.jsx";
import CourseDetailDialog from "../components/courses/CourseDetailDialog.jsx";

// Chatbot
import AIChatbot from "../components/chatbot/AIChatbot.jsx";

export default function Courses() {
  const [user, setUser] = useState(null);
  const [searchTerm, setSearchTerm] = useState("");
  const [allCourses, setAllCourses] = useState([]);
  const [isSearching, setIsSearching] = useState(false);
  const [categories, setCategories] = useState([]);
  const [colleges, setColleges] = useState([]);
  const [majors, setMajors] = useState([]);
  
  const LANGUAGE_OPTIONS = [
    { label: "International (in English)", value: "국제어수업" },
    { label: "General (in Korean)", value: "일반수업" },
    { label: "Large Online + International", value: "중대형온라인강의 + 국제어" },
    { label: "Large Online", value: "중대형온라인강의" },
  ];

  const [searchFilters, setSearchFilters] = useState({
    category: "all",
    college: "all",
    major: "all",
    language: "all",
    campus: "all",
    credits: "",
    timeOfDay: "all",
    days: [],
    minRating: "all",
  });

  const [resultFilters, setResultFilters] = useState({
    college: "all",
    major: "all",
    language: "all",
    campus: "all",
    credits: "all",
    timeOfDay: "all",
    days: [],
    minRating: "all",
  });

  const [showSearchFilters, setShowSearchFilters] = useState(false);
  const [showResultFilters, setShowResultFilters] = useState(false);
  const [expandedCourses, setExpandedCourses] = useState({});

  const [ratingDialogOpen, setRatingDialogOpen] = useState(false);
  const [detailDialogOpen, setDetailDialogOpen] = useState(false);
  const [selectedCourse, setSelectedCourse] = useState(null);

  const queryClient = useQueryClient();
  const baseUrl = import.meta.env.VITE_API_BASE_URL || "http://localhost:8080";

  useEffect(() => {
    setUser(AuthApi.me());
  }, []);

  useEffect(() => {
    const fetchCategories = async () => {
      try {
        const res = await fetch(`${baseUrl}/courses/categories`, {
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
          },
        });

        if (!res.ok) throw new Error(`Failed to load categories (${res.status})`);
        const data = await res.json();
        setCategories(data || []);
      } catch (err) {
        console.error("Error fetching categories", err);
      }
    };

    fetchCategories();
  }, [baseUrl]);

  useEffect(() => {
    const fetchColleges = async () => {
      try {
        const res = await fetch(`${baseUrl}/courses/colleges`, {
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
          },
        });
        if (!res.ok) throw new Error(`Failed to load colleges (${res.status})`);
        const data = await res.json();
        setColleges(data || []);
      } catch (err) {
        console.error("Error fetching colleges", err);
      }
    };

    fetchColleges();
  }, [baseUrl]);

  useEffect(() => {
    const fetchMajors = async () => {
      if (searchFilters.college === "all") {
        setMajors([]);
        setSearchFilters((prev) => ({ ...prev, major: "all" }));
        return;
      }
      try {
        const res = await fetch(`${baseUrl}/courses/colleges/${searchFilters.college}/majors`, {
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
          },
        });
        if (!res.ok) throw new Error(`Failed to load majors (${res.status})`);
        const data = await res.json();
        setMajors(data || []);
      } catch (err) {
        console.error("Error fetching majors", err);
      }
    };

    fetchMajors();
  }, [baseUrl, searchFilters.college]);

  // ============================================================
  // LOAD DATA
  // ============================================================
  const { data: catalog = [] } = useQuery({
    queryKey: ["catalog"],
    queryFn: () => Catalog.list(),
  });

  const { data: allReviews = [] } = useQuery({
    queryKey: ["reviews"],
    queryFn: () => Reviews.list(),
  });

  const { data: registrations = [] } = useQuery({
    queryKey: ["registrations"],
    queryFn: () => Registration.list(),
  });

  // ============================================================
  // MEMOIZED HELPERS
  // ============================================================
  const getCourseReviews = useCallback((courseId) =>
    allReviews.filter((r) => r.course_id === courseId), [allReviews]);

  const getCourseAvgRating = useCallback((courseId) => {
    const rev = getCourseReviews(courseId);
    if (rev.length === 0) return 0;
    return rev.reduce((s, r) => s + r.rating, 0) / rev.length;
  }, [getCourseReviews]);

  const isInCatalog = useCallback((courseId) =>
    catalog.some((c) => c.course_id === courseId), [catalog]);

  const getCatalogItem = useCallback((courseId) =>
    catalog.find((c) => c.course_id === courseId), [catalog]);

  const getTimeOfDay = useCallback((course) => {
    if (!course.schedule?.length) return "unknown";
    const hour = parseInt(course.schedule[0].start_time.split(":")[0]);
    if (hour < 12) return "morning";
    if (hour < 17) return "afternoon";
    return "evening";
  }, []);

  const courseMeetsDays = useCallback((course, selectedDays) => {
    if (selectedDays.length === 0) return true;
    return course.schedule?.some((slot) => selectedDays.includes(slot.day));
  }, []);

  const DAY_NAME_TO_INDEX = {
    Monday: 1,
    Tuesday: 2,
    Wednesday: 3,
    Thursday: 4,
    Friday: 5,
    Saturday: 6,
    Sunday: 7,
  };

  const CAMPUS_LOOKUP = {
    1: "HSSC",
    2: "NSC",
    3: "iCampus",
  };

  const normalizeCourse = useCallback((course) => {
    const code = course.courseCode;
    const shortCode = course.shortCourseCode;
    const placements = course.timeRoomPlacements || [];

    const majorsData = (course.majors || []).map((m) => ({
      id: m.id,
      name: m.major_name,
      collegeId: m.college_id,
    }));

    const majorNames = majorsData.map((m) => m.name).filter(Boolean);
    const collegeIds = majorsData.map((m) => m.collegeId).filter(Boolean);

    const schedule = placements.map((slot) => ({
      day: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"][
        (slot.day_of_week - 1) ?? 0
      ] || "Monday",
      start_time: (slot.start_time ?? "").toString().slice(0, 5),
      end_time: (slot.end_time ?? "").toString().slice(0, 5),
      room: slot.classroom || "TBD",
    }));

    return {
      id: course.id || code,
      code,
      base_code: shortCode,
      name: course.name_english || course.name_korean || code,
      description: course.description_english || course.description_korean || "",
      campus: CAMPUS_LOOKUP[course.campus] || "Unknown",
      course_language: course.course_language || course.courseLanguage || null,
      credits: Number(course.credits) || 0,
      schedule,
      instructor:
        (course.instructor && course.instructor.instructor_name) ||
        (course.instructor_id ? `Instructor ${course.instructor_id}` : "TBD"),
      majors: majorsData,
      majorNames,
      collegeIds,
      majorLabel: majorNames[0] || course.category || "General",
      enrolled: course.enrolled || 0,
      capacity: course.capacity || 0,
    };
  }, []);

  const handleSearch = useCallback(async () => {
    setIsSearching(true);
    try {
      const filterPayload = {
        searchTerm: searchTerm || "",
        category: searchFilters.category !== "all" ? searchFilters.category : null,
        collegeId: searchFilters.college !== "all" ? Number(searchFilters.college) : null,
        majorId: searchFilters.major !== "all" ? Number(searchFilters.major) : null,
        courseLanguage:
          searchFilters.language !== "all"
            ? LANGUAGE_OPTIONS.find((o) => o.label === searchFilters.language)?.value ||
              searchFilters.language
            : null,
        credits: searchFilters.credits ? Number(searchFilters.credits) : 0,
        daysOfWeek: searchFilters.days
          .map((d) => DAY_NAME_TO_INDEX[d])
          .filter((v) => v !== undefined),
        campus:
          searchFilters.campus === "HSSC"
            ? 1
            : searchFilters.campus === "NSC"
            ? 2
            : searchFilters.campus === "iCampus"
            ? 3
            : 0,
        timeOfDay:
          searchFilters.timeOfDay !== "all"
            ? searchFilters.timeOfDay.toUpperCase()
            : "ALL",
      };

      const response = await fetch(`${baseUrl}/courses/search`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Accept: "application/json",
        },
        body: JSON.stringify(filterPayload),
      });

      if (!response.ok) {
        throw new Error(`Search failed with status ${response.status}`);
      }

      const data = await response.json();
      const flattened = Object.values(data || {}).flat();
      setAllCourses(flattened.map(normalizeCourse));
    } catch (err) {
      console.error("Error searching courses", err);
    } finally {
      setIsSearching(false);
    }
  }, [baseUrl, searchTerm, searchFilters, normalizeCourse, LANGUAGE_OPTIONS, DAY_NAME_TO_INDEX]);

  // ============================================================
  // MUTATIONS
  // ============================================================
  const addToCatalog = useMutation({
    mutationFn: (course) =>
      Catalog.add({
        course_id: course.id,
        course_code: course.code,
        course_name: course.name,
        base_code: course.base_code,
      }),
    onSuccess: () => queryClient.invalidateQueries(["catalog"]),
  });

  const removeFromCatalog = useMutation({
    mutationFn: (id) => Catalog.remove(id),
    onSuccess: () => queryClient.invalidateQueries(["catalog"]),
  });

  const submitReview = useMutation({
    mutationFn: (reviewData) =>
      Reviews.add({
        course_id: selectedCourse.id,
        course_code: selectedCourse.code,
        reviewer_name: user.full_name,
        ...reviewData,
      }),
    onSuccess: () => {
      queryClient.invalidateQueries(["reviews"]);
      setRatingDialogOpen(false);
      setSelectedCourse(null);
    },
  });

  // ============================================================
  // MEMOIZED FILTERING
  // ============================================================
  const filteredCourses = useMemo(() => {
    return allCourses.filter((course) => {
      const matchesCollege =
        resultFilters.college === "all" ||
        (course.collegeIds || []).includes(Number(resultFilters.college));

      const matchesMajor =
        resultFilters.major === "all" ||
        (course.majorNames || []).includes(resultFilters.major) ||
        course.majorLabel === resultFilters.major;

      const matchesLanguage =
        resultFilters.language === "all" ||
        LANGUAGE_OPTIONS.some(
          (opt) =>
            opt.label === resultFilters.language &&
            opt.value === course.course_language
        );

      const matchesCampus =
        resultFilters.campus === "all" || course.campus === resultFilters.campus;

      const matchesCredits =
        resultFilters.credits === "all" ||
        course.credits === Number(resultFilters.credits);

      const matchesTime =
        resultFilters.timeOfDay === "all" ||
        getTimeOfDay(course) === resultFilters.timeOfDay;

      const matchesDays = courseMeetsDays(course, resultFilters.days);

      const avgRating = getCourseAvgRating(course.id);
      const matchesRating =
        resultFilters.minRating === "all" ||
        avgRating >= Number(resultFilters.minRating);

      return (
        matchesCollege &&
        matchesMajor &&
        matchesLanguage &&
        matchesCampus &&
        matchesCredits &&
        matchesTime &&
        matchesDays &&
        matchesRating
      );
    });
  }, [allCourses, resultFilters, LANGUAGE_OPTIONS, getTimeOfDay, courseMeetsDays, getCourseAvgRating]);

  const groupedCourses = useMemo(() => {
    const grouped = {};
    filteredCourses.forEach((course) => {
      if (!grouped[course.base_code]) {
        grouped[course.base_code] = [];
      }
      grouped[course.base_code].push(course);
    });
    return grouped;
  }, [filteredCourses]);

  const majorOptions = useMemo(() => 
    [...new Set(
      allCourses.flatMap((c) => c.majorNames || []).concat(allCourses.map((c) => c.majorLabel))
    )].filter(Boolean),
    [allCourses]
  );

  const creditOptions = useMemo(() => 
    [...new Set(allCourses.map((c) => c.credits))].sort(),
    [allCourses]
  );

  // ============================================================
  // POPULAR COMBINATIONS
  // ============================================================
  const popularCombinations = useMemo(() => {
    const combinations = {};
    const byUser = {};

    registrations.forEach((r) => {
      if (!r.created_by) return;
      if (!byUser[r.created_by]) byUser[r.created_by] = new Set();
      byUser[r.created_by].add(r.course_code);
    });

    for (const user in byUser) {
      const codes = [...byUser[user]];
      for (let i = 0; i < codes.length; i++) {
        for (let j = i + 1; j < codes.length; j++) {
          const key = [codes[i], codes[j]].sort().join("-");
          combinations[key] = (combinations[key] || 0) + 1;
        }
      }
    }

    return Object.entries(combinations)
      .sort((a, b) => b[1] - a[1])
      .slice(0, 5)
      .map(([key, count]) => {
        const [a, b] = key.split("-");
        return { code1: a, code2: b, count };
      });
  }, [registrations]);

  const activeSearchFilters = useMemo(() => 
    [
      searchFilters.category !== "all",
      searchFilters.college !== "all",
      searchFilters.major !== "all",
      searchFilters.language !== "all",
      searchFilters.campus !== "all",
      !!searchFilters.credits,
      searchFilters.timeOfDay !== "all",
      searchFilters.days.length > 0,
      searchFilters.minRating !== "all",
    ].filter(Boolean).length,
    [searchFilters]
  );

  const activeResultFilters = useMemo(() => 
    [
      resultFilters.college !== "all",
      resultFilters.major !== "all",
      resultFilters.language !== "all",
      resultFilters.campus !== "all",
      resultFilters.credits !== "all",
      resultFilters.timeOfDay !== "all",
      resultFilters.days.length > 0,
      resultFilters.minRating !== "all",
    ].filter(Boolean).length,
    [resultFilters]
  );

  const clearSearchFilters = useCallback(() => {
    setMajors([]);
    setSearchFilters({
      category: "all",
      college: "all",
      major: "all",
      language: "all",
      campus: "all",
      credits: "",
      timeOfDay: "all",
      days: [],
      minRating: "all",
    });
  }, []);

  const clearResultFilters = useCallback(() =>
    setResultFilters({
      college: "all",
      major: "all",
      language: "all",
      campus: "all",
      credits: "all",
      timeOfDay: "all",
      days: [],
      minRating: "all",
    }),
    []
  );

  const toggleCourseExpanded = useCallback((baseCode) => {
    setExpandedCourses(prev => ({
      ...prev,
      [baseCode]: !prev[baseCode]
    }));
  }, []);

  // ============================================================
  // UI
  // ============================================================
  return (
    <div className="min-h-screen bg-gradient-to-br from-emerald-50 via-white to-green-50 p-4 md:p-8">
      <div className="max-w-7xl mx-auto space-y-6">

        {/* TITLE */}
        <div className="text-center space-y-2">
          <h1 className="text-4xl md:text-5xl font-bold text-gray-900 tracking-tight">
            Course Catalog
          </h1>
          <p className="text-gray-600 text-lg">
            Browse, rate, and add courses to your schedule
          </p>
        </div>

        {/* POPULAR COMBINATIONS */}
        {popularCombinations.length > 0 && (
          <Card className="p-6 border-2 border-emerald-600 bg-gradient-to-br from-emerald-50 to-green-50 shadow-lg rounded-2xl">
            <div className="flex items-center gap-2 mb-4">
              <TrendingUp className="w-5 h-5 text-emerald-600" />
              <h3 className="text-lg font-bold text-gray-900">
                Popular Course Combinations
              </h3>
            </div>

            <div className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
              {popularCombinations.map((pair, idx) => (
                <div
                  key={idx}
                  className="p-4 rounded-xl border-2 border-emerald-600 bg-white shadow-sm text-center hover:shadow-md transition-shadow"
                >
                  <p className="font-bold text-gray-900">{pair.code1}</p>
                  <p className="text-emerald-600 text-sm font-semibold">+</p>
                  <p className="font-bold text-gray-900">{pair.code2}</p>
                  <Badge className="mt-2 bg-emerald-100 text-emerald-700 text-xs">
                    {pair.count} students
                  </Badge>
                </div>
              ))}
            </div>
          </Card>
        )}

        {/* SEARCH + FILTERS */}
        <Card className="p-6 rounded-2xl border-2 border-emerald-600 shadow-lg bg-white">
          <div className="flex flex-col md:flex-row gap-4">
            <div className="relative flex-1">
              <Search className="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 w-5 h-5" />
              <Input
                placeholder="Search by course name, code, or instructor..."
                className="pl-10 h-12 rounded-xl border-2 border-gray-200 focus:border-emerald-600"
                value={searchTerm}
                onChange={(e) => setSearchTerm(e.target.value)}
                onKeyDown={(e) => {
                  if (e.key === "Enter") handleSearch();
                }}
              />
            </div>

            <Button
              className="h-12 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white px-6"
              onClick={handleSearch}
              disabled={isSearching}
            >
              {isSearching ? (
                <>
                  <Loader2 className="w-4 h-4 mr-2 animate-spin" />
                  Searching...
                </>
              ) : (
                <>
                  <Search className="w-4 h-4 mr-2" />
                  Search
                </>
              )}
            </Button>

            <Button
              variant="outline"
              className="h-12 rounded-xl border-2 border-emerald-600 text-emerald-700 hover:bg-emerald-50"
              onClick={() => setShowSearchFilters(!showSearchFilters)}
            >
              <Filter className="w-4 h-4 mr-2" /> 
              Filters
              {activeSearchFilters > 0 && (
                <Badge className="ml-2 bg-emerald-600 text-white">
                  {activeSearchFilters}
                </Badge>
              )}
            </Button>
          </div>

          {/* FILTER PANEL */}
          {showSearchFilters && (
            <div className="mt-6 pt-6 border-t-2 border-gray-100">
              <div className="flex justify-between items-center mb-4">
                <h3 className="text-lg font-bold text-gray-900">Search Filters</h3>
                <Button 
                  variant="ghost" 
                  onClick={clearSearchFilters}
                  className="text-gray-600 hover:text-gray-900"
                >
                  <X className="w-4 h-4 mr-2" /> Clear All
                </Button>
              </div>

              {/* FILTER GRID */}
              <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                {/* Category */}
                <div>
                  <label className="text-sm font-semibold text-gray-700 mb-2 block">Category</label>
                  <Select
                    value={searchFilters.category}
                    onValueChange={(v) =>
                      setSearchFilters((f) => ({ ...f, category: v }))
                    }
                  >
                    <SelectTrigger className="rounded-xl h-10">
                      <SelectValue placeholder="Select" />
                    </SelectTrigger>
                    <SelectContent className="max-h-60">
                      <SelectItem value="all">All</SelectItem>
                      {categories.map((cat) => (
                        <SelectItem key={cat} value={cat}>
                          {cat}
                        </SelectItem>
                      ))}
                    </SelectContent>
                  </Select>
                </div>

                {/* College */}
                <div>
                  <label className="text-sm font-semibold text-gray-700 mb-2 block">College</label>
                  <Select
                    value={searchFilters.college}
                    onValueChange={(v) =>
                      setSearchFilters((f) => ({ ...f, college: v, major: "all" }))
                    }
                  >
                    <SelectTrigger className="rounded-xl h-10">
                      <SelectValue placeholder="Select" />
                    </SelectTrigger>
                    <SelectContent className="max-h-60">
                      <SelectItem value="all">All</SelectItem>
                      {colleges.map((c) => (
                        <SelectItem key={c.id} value={String(c.id)}>
                          {c.name || c.college_name || c.collegeName}
                        </SelectItem>
                      ))}
                    </SelectContent>
                  </Select>
                </div>

                {/* Major */}
                <div>
                  <label className="text-sm font-semibold text-gray-700 mb-2 block">Major</label>
                  <Select
                    value={searchFilters.major}
                    onValueChange={(v) =>
                      setSearchFilters((f) => ({ ...f, major: v }))
                    }
                  >
                    <SelectTrigger className="rounded-xl h-10" disabled={majors.length === 0}>
                      <SelectValue placeholder="Select" />
                    </SelectTrigger>
                    <SelectContent className="max-h-60">
                      <SelectItem value="all">All</SelectItem>
                      {majors.map((m) => (
                        <SelectItem key={m.id} value={String(m.id)}>
                          {m.name || m.major_name || m.majorName}
                        </SelectItem>
                      ))}
                    </SelectContent>
                  </Select>
                </div>

                {/* Language */}
                <div>
                  <label className="text-sm font-semibold text-gray-700 mb-2 block">Language</label>
                  <Select
                    value={searchFilters.language}
                    onValueChange={(v) =>
                      setSearchFilters((f) => ({ ...f, language: v }))
                    }
                  >
                    <SelectTrigger className="rounded-xl h-10">
                      <SelectValue placeholder="Any" />
                    </SelectTrigger>
                    <SelectContent className="max-h-60">
                      <SelectItem value="all">Any</SelectItem>
                      {LANGUAGE_OPTIONS.map((opt) => (
                        <SelectItem key={opt.label} value={opt.label}>
                          {opt.label}
                        </SelectItem>
                      ))}
                    </SelectContent>
                  </Select>
                </div>

                {/* Campus */}
                <div>
                  <label className="text-sm font-semibold text-gray-700 mb-2 block">Campus</label>
                  <Select
                    value={searchFilters.campus}
                    onValueChange={(v) =>
                      setSearchFilters((f) => ({ ...f, campus: v }))
                    }
                  >
                    <SelectTrigger className="rounded-xl h-10">
                      <SelectValue placeholder="Select" />
                    </SelectTrigger>
                    <SelectContent>
                      <SelectItem value="all">All</SelectItem>
                      <SelectItem value="HSSC">HSSC</SelectItem>
                      <SelectItem value="NSC">NSC</SelectItem>
                      <SelectItem value="iCampus">iCampus</SelectItem>
                    </SelectContent>
                  </Select>
                </div>

                {/* Credits */}
                <div>
                  <label className="text-sm font-semibold text-gray-700 mb-2 block">Credits</label>
                  <Input
                    type="number"
                    placeholder="e.g. 3"
                    value={searchFilters.credits}
                    onChange={(e) =>
                      setSearchFilters((f) => ({ ...f, credits: e.target.value }))
                    }
                    className="rounded-xl h-10"
                  />
                </div>

                {/* Time of Day */}
